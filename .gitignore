node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ─── Environment ──────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Build outputs ────────────────────────────────────────
dist/
build/
*.tsbuildinfo

